---
layout: nil
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"
     xmlns:atom="http://www.w3.org/2005/Atom">

  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ site.url }}</link>
    <language>en-us</language>
    <description>{{ site.description | xml_escape }}</description>

    <itunes:author>{{ site.author }}</itunes:author>
    <itunes:explicit>false</itunes:explicit>
    <itunes:image href="{{ site.url }}/images/og-preview.jpg" />
    <itunes:category text="Society &amp; Culture">
      <itunes:category text="Philosophy"/>
    </itunes:category>
    <itunes:summary>{{ site.description | xml_escape }}</itunes:summary>
    <itunes:subtitle>A podcast exploring mysticism, art, and psychedelic tech</itunes:subtitle>
    <itunes:keywords>psychedelic, mysticism, art, cyberpunk, culture, spirituality</itunes:keywords>

    <itunes:owner>
      <itunes:name>{{ site.author }}</itunes:name>
      <itunes:email>dseekeroftruth@gmail.com</itunes:email>
    </itunes:owner>

    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml" />

    {% assign podcast_posts = site.posts | where_exp: "post", "post.audio_url" %}
    {% for post in podcast_posts %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <description>{{ post.excerpt | strip_html | xml_escape }}</description>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <guid isPermaLink="false">{{ post.url | absolute_url }}</guid>
      <link>{{ post.url | absolute_url }}</link>

      <enclosure 
        url="{{ post.audio_url }}" 
        type="audio/mpeg" 
        length="{{ post.audio_length | default: 1000000 }}" />

      <itunes:duration>{{ post.duration | default: "0:00" }}</itunes:duration>
      <itunes:subtitle>{{ post.subtitle | default: post.title | xml_escape }}</itunes:subtitle>
    </item>
    {% endfor %}
  </channel>
</rss>
